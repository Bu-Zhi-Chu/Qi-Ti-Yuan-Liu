                    },
                    {
                        "value": "date",
                        "label": "年月日"
                    },
                    {
                        "value": "time",
                        "label": "时分秒"
                    },
                    {
                        "value": "year",
                        "label": "年份"
                    },
                    {
                        "value": "month",
                        "label": "月份"
                    },
                    {
                        "value": "weekday",
                        "label": "星期"
                    },
                    {
                        "value": "day",
                        "label": "日期"
                    }
                ]
            }
        }
    },
    {
        "type": "ButtonGroup",
        "nameZh": "按钮组",
        "path": "../blocks/ButtonGroup.svelte",
        "showFeatureTab": true,
        "featureProps": {
            "buttonCount": {
                "label": "按钮个数",
                "type": "number",
                "min": 1,
                "max": 10,
                "default": 3
            }
        }
    },
    {
        "type": "Button",
        "nameZh": "按钮",
        "path": "../blocks/Button.svelte",
        "showFeatureTab": true,
        "presetStyles": {
            "display": "flex",
            "justifyContent": "center",
            "alignItems": "center",
            "cursor": "pointer"
        },
        "featureProps": {
            "enableClick": {
                "label": "点击事件",
                "type": "switch",
                "default": false
            }
        }
    }
