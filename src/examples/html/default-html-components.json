  "hello-world": {
    "name": "Hello World",
    "description": "最基础的HTML页面结构示例",
    "code": "<!DOCTYPE html>\n<html lang=\"zh-CN\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Hello World</title>\n</head>\n<body>\n    <h1>Hello World</h1>\n    <p>Welcome to HTML!</p>\n</body>\n</html>"
