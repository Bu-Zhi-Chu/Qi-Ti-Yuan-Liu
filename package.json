    "type": "module",
    "scripts": {
        "dev": "vite",
        "dev:lan": "vite --host 0.0.0.0 --port 5173",
        "build": "vite build && vite preview --port 4173 --open",
        "build:lite": "cross-env LITE=true vite build && cross-env LITE=true vite preview --outDir dist-lite --port 4174 --open",
